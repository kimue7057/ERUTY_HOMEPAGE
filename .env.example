# No environment variables are required for the current frontend build.
# The values below are optional toggles or reserved placeholders for future API integration.

# Runtime mode
VITE_APP_ENV=development

# Optional: set to false when replacing mock submissions with a real API.
VITE_ENABLE_MOCK_SUBMISSIONS=true

# Reserved for future inquiry API integration
VITE_INQUIRY_API_BASE_URL=
VITE_INQUIRY_API_KEY=

# Reserved for future careers API integration
VITE_CAREERS_API_BASE_URL=
VITE_CAREERS_API_KEY=

# Optional upload settings
VITE_UPLOAD_MAX_FILE_MB=20
