{
  "name": "eruty-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run build",
    "capture:site": "node scripts/capture-site.mjs",
    "audit:design": "npm run audit:design:foundation",
    "audit:design:foundation": "node scripts/audit-design-foundation.mjs",
    "audit:design:foundation:equivalence": "node scripts/audit-design-foundation-equivalence.mjs",
    "audit:design:home-pilot": "node scripts/audit-home-design-system-pilot.mjs",
    "audit:footer-overflow": "node scripts/audit-footer-overflow.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.5.4",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
